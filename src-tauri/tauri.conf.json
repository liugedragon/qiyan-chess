{
  "bundle": {
    "active": true,
    "category": "BoardGame",
    "copyright": "",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "publisher": "liugedragon",
    "shortDescription": "Chess analysis and local play",
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": {
      "../sound/": "sound/",
      "../aixchess.duckdb_extension": "aixchess.duckdb_extension",
      "resources/vision/": "vision/",
      "../vendor/engine/": "engine/"
    },
    "targets": "all",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeDevCommand": "pnpm prepare:aix-extension && pnpm start-vite",
    "beforeBuildCommand": "pnpm prepare:aix-extension && pnpm build-vite",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "productName": "棋研",
  "mainBinaryName": "QiyanChess",
  "identifier": "local.qiyan.chess",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "qiyanchess"
        ]
      }
    },
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "棋研 · 对战与复盘",
        "visible": false,
        "decorations": true,
        "width": 1280,
        "height": 850
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  },
  "version": "0.15.1-qiyan.1"
}
